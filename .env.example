APP_NAME=Onedo bot
APP_DOMAIN=localhost
SECRET_KEY=change-me-onedo-bot-secret-key-32chars
ADMIN_API_TOKEN=onedo-admin-api-token-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# دیتابیس (برای docker-compose.registry.yml؛ DATABASE_URL را بک‌اند از همین‌ها می‌سازد)
POSTGRES_USER=onedo
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=onedo_bot
DATABASE_URL=postgresql+psycopg2://onedo:change-me-strong-db-password@db:5432/onedo_bot

# تگ ایمیج منتشرشده (اختیاری؛ پیش‌فرض latest)
# ONEDO_IMAGE_TAG=latest
# پورت میزبان nginx (اختیاری؛ پیش‌فرض 12277)
# ONEDO_PORT=12277

OPENAI_COMPATIBLE_BASE_URL=https://onedo.ir/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=auto
# تنها کاربر پنل (تک‌کاربره؛ بدون جدول users)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMeStrong!
CORS_ORIGINS=http://localhost:12277
